# ─── FalkorDB (required) ──────────────────────────────────────────────
# Local Docker (npm run db):            redis://localhost:6379
# FalkorDB Cloud: copy host, port, username and password from the console, e.g.
#   FALKORDB_URL=rediss://default:YOUR_PASSWORD@your-instance.falkordb.cloud:6379
FALKORDB_URL=redis://localhost:6379
# Base graph name. Each clinic gets its own graph: "domino" (Riverside) and "domino_lakeview" (Lakeview).
# Tests use "domino_test*" and the benchmark "domino_bench*", so they never touch these.
FALKORDB_GRAPH=domino

# ─── Agents and semantic memory (optional) ────────────────────────────
# Without a key, the agents run as a deterministic graph planner (same tools, same graph) and team memory is searched
# by words. With GEMINI_API_KEY (https://aistudio.google.com/apikey):
#   - each agent is a Gemini tool-calling loop (default gemini-3.8-flash; falls back to 3.6 Flash, 3.5 Flash-Lite and
#     2.5 Flash when a model is over quota or not open to the key; if every model fails, the graph planner finishes
#     the step and the console says so);
#   - notes, tasks, decisions and conversations are embedded (gemini-embedding-2, 768 dimensions) into a FalkorDB
#     vector index, and the care-team search works by words, meaning and the graph. Run "npm run embed" once after
#     adding the key (or let searches embed as they go).
# Set ONE key (auto order: anthropic, then gemini, then openai). Embeddings always use the Gemini key.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works too (Groq, OpenRouter, Together, a local Ollama):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Force a provider or model:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# Gemini 3 thinking level for agent turns (low is fastest; medium, high):
# GEMINI_THINKING=low
# Embeddings: model override, or turn search by meaning off while keeping the Gemini agents:
# EMBEDDING_MODEL=gemini-embedding-2
# DOMINO_EMBEDDINGS=off

# ─── Security ─────────────────────────────────────────────────────────
# Signs agent handoffs, tasks and clinician decisions. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOMINO_SIGNING_SECRET=
# If set, every write (decisions, tasks, reviews, prescriptions, reset) needs this key.
# Leave empty for a local demo.
DOMINO_WRITE_KEY=
# Public demo: with the key set, everything a visitor needs to try the product (reviews, questions, decisions, inbox tasks,
# adding a prescription except to the story patients, team notes without links, check-ups, the EHR demo) works without it; the key
# still guards admin actions (sweep, reset).
DOMINO_OPEN_DEMO=false
# "nightly": the nightly cron rebuilds every clinic's graph from the seed, so one visitor's changes are gone the next day.
DOMINO_DEMO_RESET=
# Rate limits are per client IP only when this is true. Set it to true on Vercel or behind a reverse proxy
# you control that sets X-Real-IP / X-Forwarded-For. When false, all callers share one rate-limit bucket,
# because those headers could be forged.
DOMINO_TRUST_PROXY=false
# CDS Hooks: the EHRs whose signed calls Domino trusts, as JSON from issuer to its JWKS (a URL or the key set).
# When set, every call to /cds-services/* needs a valid ES384/RS384 token from one of them (or the access key).
# It also needs DOMINO_SITE_URL (below), so tokens are checked against this service's real URL; a malformed value
# refuses every call rather than turning the check off.
# Leave empty for the open demo. Example:
# DOMINO_CDS_ISSUERS={"https://sandbox.cds-hooks.org":"https://sandbox.cds-hooks.org/.well-known/jwks.json"}
DOMINO_CDS_ISSUERS=

# ─── MCP server (npm run mcp) ─────────────────────────────────────────
# Read-only by default. true also registers run_review (writes findings and proposed tasks).
DOMINO_MCP_ALLOW_WRITES=false
# Which clinic's graph the MCP server serves (riverside or lakeview).
DOMINO_CLINIC=riverside

# ─── Tuning ───────────────────────────────────────────────────────────
# Pause between planner steps in the live UI so people can follow along (ms).
DOMINO_PLANNER_PACE_MS=320
# Synthetic cohort size used by npm run seed.
DOMINO_COHORT_SIZE=600

# ─── Scheduled sweep (optional) ───────────────────────────────────────
# Scheduled jobs, with "Authorization: Bearer <CRON_SECRET>" (16+ characters): GET /api/cron/sweep (vercel.json runs it daily at
# 21:30 UTC: a sweep, or a full rebuild with DOMINO_DEMO_RESET=nightly) and GET /api/cron/keepalive (every three hours from
# .github/workflows/keepalive.yml: keeps an idle hosted database awake and reseeds any clinic graph that came back empty).
CRON_SECRET=
# Longest a read query may run before FalkorDB stops it (ms).
DOMINO_QUERY_TIMEOUT_MS=15000

# Public URL of the deployment, used for share images and links (optional; Vercel sets its own).
# DOMINO_SITE_URL=https://domino.example.com
